{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Radiate window may use.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen"
  ]
}
